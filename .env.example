# Anam (avatar) — server only
ANAM_API_KEY=

# OpenAI — powers FAISS embeddings + answer generation (optional; lexical fallback without it)
OPENAI_API_KEY=

# LangSmith / LangChain tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=thesis-rag-service

# Frontend → backend
RAG_SERVICE_URL=http://127.0.0.1:8000

# Backend CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
