# Anam (avatar) — server only
ANAM_API_KEY=
# Optional: saved Lab persona (includes likeness + voice). Prefer this if you created one in Anam Lab.
ANAM_PERSONA_ID=
# Optional: override voice on the ephemeral persona (ignored when ANAM_PERSONA_ID is set)
# Default cloned voice in code: 0cc6fa24-f25b-4e2e-a277-29608539fbcf
ANAM_VOICE_ID=
# Optional: override likeness avatar id (ignored when ANAM_PERSONA_ID is set)
ANAM_AVATAR_ID=

# OpenAI — synthesises spoken answers from retrieved thesis excerpts
# (backend: FAISS + chat; hosted frontend: chat over lexical retrieval). Lexical-only without it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# LangSmith / LangChain tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=thesis-rag-service

# Frontend → backend (optional; omit on hosted Cursor apps — local RAG is used)
RAG_SERVICE_URL=http://127.0.0.1:8000

# Backend CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
